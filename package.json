{
  "name": "accountable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run --directory backend uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm run dev --workspace frontend",
    "start": "node scripts/start.mjs",
    "test": "node scripts/test-run.mjs test:all",
    "test:all": "concurrently --names backend,frontend,e2e,scripts \"npm:test:backend:raw\" \"npm:test:frontend:raw\" \"npm:test:e2e:raw\" \"npm:test:scripts:raw\"",
    "test:backend": "node scripts/test-run.mjs test:backend:raw",
    "test:backend:raw": "uv run pytest",
    "test:frontend": "node scripts/test-run.mjs test:frontend:raw",
    "test:frontend:raw": "npm run test --workspace frontend",
    "test:scripts": "node scripts/test-run.mjs test:scripts:raw",
    "test:scripts:raw": "node --test scripts/*.test.mjs",
    "test:unit": "node scripts/test-run.mjs test:unit:all",
    "test:unit:all": "concurrently --names backend,frontend,scripts \"npm:test:backend:raw\" \"npm:test:frontend:raw\" \"npm:test:scripts:raw\"",
    "test:e2e": "node scripts/test-run.mjs test:e2e:raw",
    "test:e2e:raw": "node scripts/e2e.mjs",
    "seed": "node scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "uv run ty check backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm run typecheck && eslint . && prettier --check .",
    "lint:backend": "npm run typecheck:backend && uv run ruff check backend && uv run ruff format --check backend",
    "format": "prettier --write . && uv run ruff format backend",
    "secrets": "gitleaks dir . --no-banner",
    "prepare": "lefthook install",
    "check:static": "npm run lint && npm run secrets",
    "check:quick": "node scripts/test-run.mjs check:quick:raw",
    "check:quick:raw": "npm run check:static && npm run test:unit",
    "check": "node scripts/test-run.mjs check:raw",
    "check:raw": "npm run check:static && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
